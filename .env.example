# ─── AI API Keys ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# Google OAuth
GEMINI_AUTH_MODE=api_key
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_PROJECT_ID=your_project_id
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
GOOGLE_OAUTH_JSON_PATH=/path/to/your/client_secret.json

# ─── AI Models ────────────────────────────────────────────────────────────────
PRIMARY_MODEL=gemini-3-flash-preview
FALLBACK_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
WA_CAMPAIGN_AI_ENABLED=true
WA_CAMPAIGN_AI_MODEL=gemini-2.5-flash
WA_AI_MIN_CHARS=20
WA_AI_MAX_CHARS=1100
WA_AI_MAX_PARAGRAPHS=20
WA_AI_BLOCKED_TERMS=as an ai,i am an ai,i cannot,i can not,language model,generated message,here is your message,subject:,dear sir/madam

# ─── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PORT=2105

# ─── Rate Limiting ────────────────────────────────────────────────────────────
MIN_DELAY=2000
MAX_DELAY=5000
TYPING_MIN=3000
TYPING_MAX=6000
MAX_BURST=10
COOLDOWN_PERIOD=20000

# ─── Bot Settings ─────────────────────────────────────────────────────────────
MAX_HISTORY=10
MAX_OUTPUT_TOKENS=500000

# ─── Email Accounts (Google Workspace SMTP) ──────────────────────────────────

# Account 1 
EMAIL_1_USER=your_email1@domain.com
EMAIL_1_PASSWORD=your_app_password
EMAIL_1_NAME=Your Name

# Account 2 (optional)
EMAIL_2_USER=your_email2@domain.com
EMAIL_2_PASSWORD=your_app_password
EMAIL_2_NAME=Your Name

# Account 3 (optional)
EMAIL_3_USER=your_email3@domain.com
EMAIL_3_PASSWORD=your_app_password
EMAIL_3_NAME=Your Name

# Daily limit per account (Google Workspace = 2000)
EMAIL_DAILY_LIMIT=500
EMAIL_PROVIDER_DAILY_LIMIT=500
