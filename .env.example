# =========================
# AI
# =========================
GEMINI_API_KEY=your_gemini_api_key

# Gemini campaign AI
FALLBACK_MODEL=gemini-2.5-flash
WA_CAMPAIGN_AI_ENABLED=true
WA_CAMPAIGN_AI_MODEL=gemini-2.5-flash
WA_AI_MIN_CHARS=20
WA_AI_MAX_CHARS=1100
WA_AI_MAX_PARAGRAPHS=20
WA_AI_BLOCKED_TERMS=as an ai,i am an ai,i cannot,i can not,language model,generated message,here is your message,subject:,dear sir/madam

# =========================
# Dashboard
# =========================
# For local use. In Azure App Service, platform `PORT` / `WEBSITES_PORT` is used automatically.
DASHBOARD_PORT=3000

# Optional runtime data location (session/log/presets). Default auto-detects Azure /home/site/data.
APP_DATA_DIR=

# Optional when Chromium is installed at a custom path.
PUPPETEER_EXECUTABLE_PATH=

# =========================
# Email Accounts (SMTP)
# =========================
EMAIL_1_USER=your_email1@domain.com
EMAIL_1_PASSWORD=your_app_password_1
EMAIL_1_NAME=Your Name

# Optional secondary account
EMAIL_2_USER=
EMAIL_2_PASSWORD=
EMAIL_2_NAME=

# Optional third account
EMAIL_3_USER=
EMAIL_3_PASSWORD=
EMAIL_3_NAME=

# Sending limits
EMAIL_DAILY_LIMIT=500
EMAIL_PROVIDER_DAILY_LIMIT=2000
